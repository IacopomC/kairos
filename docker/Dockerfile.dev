# Build environment for the KAIROS / Hydra colcon workspace (ROS 2 Jazzy).
# The workspace source is NOT baked into the image; it is mounted at runtime
# (see run.sh) so it can be rebuilt without rebuilding the image. Built on
# Hydra-ROS's `minimal` image, which carries ROS 2 Jazzy and Hydra's build
# dependencies; this adds the Python runtime's dependencies.
ARG BASE_IMAGE=hydra-minimal
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# numpy is held at the system version, which pip cannot replace.
# hydra_python imports spark_dataset_interfaces at import time.
RUN printf 'numpy==%s\n' "$(python3 -c 'import numpy; print(numpy.__version__)')" \
      > /etc/kairos-pip-constraints.txt && \
    pip3 install --break-system-packages --no-cache-dir -c /etc/kairos-pip-constraints.txt \
        click distinctipy imageio networkx pandas pyqtgraph pyyaml rosbags scipy \
        shapely sortedcontainers tqdm zmq && \
    pip3 install --break-system-packages --no-cache-dir --no-deps \
        "spark_dataset_interfaces @ git+https://github.com/MIT-SPARK/spark_dataset_interfaces"

# The Rerun renderer's environment: Rerun needs numpy 2, the system Python keeps
# numpy 1. setup_runtime.sh installs the renderer itself from the mounted source.
RUN python3 -m venv /opt/kairos_viz && \
    /opt/kairos_viz/bin/pip install --no-cache-dir "rerun-sdk==0.34.1" && \
    ln -s /opt/kairos_viz/bin/kairos-visualize /usr/local/bin/kairos-visualize

WORKDIR /ws
CMD ["/bin/bash"]
